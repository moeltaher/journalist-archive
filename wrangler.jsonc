{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "journalist-archive",
  "main": "src/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "INSPECT_LIMITER",
      "namespace_id": "195201",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "ARTICLE_LIMITER",
      "namespace_id": "195202",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "ARCHIVE_LIMITER",
      "namespace_id": "195203",
      "simple": {
        "limit": 4,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_ARCHIVE_MINUTE_LIMITER",
      "namespace_id": "195205",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ARCHIVE_QUOTA",
        "class_name": "ArchiveQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_archive_quota",
      "new_sqlite_classes": [
        "ArchiveQuota"
      ]
    }
  ],
  "keep_vars": true,
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFvx8R04Xvqa0xH7"
  }
}
